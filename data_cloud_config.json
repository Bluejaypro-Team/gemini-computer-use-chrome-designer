{
  "skill_name": "gemini-computer-use-chrome-designer",
  "version": "1.5.0",
  "gcp_project": "tidal-mode-490503-i9",
  "gcp_region": "us-central1",
  "cloud_artifact_registry": "us-central1-docker.pkg.dev/tidal-mode-490503-i9/agent-releases/gemini-computer-use-chrome-designer:latest",
  "cloud_run_job": "gemini-chrome-designer-job",
  "service_account": "bjp-agent-runner@tidal-mode-490503-i9.iam.gserviceaccount.com",
  "secrets": {
    "gemini-api-key": {
      "secret_manager_id": "gemini-api-key",
