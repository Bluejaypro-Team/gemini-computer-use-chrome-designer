  "build": {
    "machine_type": "E2_HIGHCPU_8",
    "timeout": "900s",
    "logging": "CLOUD_LOGGING_ONLY",
    "tags": ["gemini-chrome-designer", "agent-releases"]
  },
  "runtime": {
    "base_image": "python:3.10-slim-bookworm",
    "python": ">=3.10",
    "system_packages": [
      "wget", "curl", "libnss3", "libx11-6", "libxcb1", "libxcomposite1",
      "libxcursor1", "libxdamage1", "libxext6", "libxi6", "libxtst6", 
      "libglib2.0-0", "libnss3", "libcups2", "libdbus-1-3", "libxrandr2", 
      "libasound2", "libatk1.0-0", "libatk-bridge2.0-0", "libpango-1.0-0", "libcairo2"
